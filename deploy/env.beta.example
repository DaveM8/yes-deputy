# Copy to /data/members_questions-beta/.env.beta (gitignored by .env.*).
# Secrets (API keys, JWT_SECRET, ES credentials) come from the stable .env.
APP_ENV=beta
ADMIN_ONLY=1
QUERY_LOG_TABLE=query_log_beta
# Shared user accounts with the main site
DB_PATH=/data/members_questions/data/users.db
SITE_URL=https://beta.yesdeputy.com
