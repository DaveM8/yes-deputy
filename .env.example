# Required
OPENAI_API_KEY=sk-...
JWT_SECRET=change-me-to-a-long-random-string

# Elasticsearch (defaults shown)
ES_HOST=http://localhost:9200
ES_INDEX=oireachtas-chunks
# ES_USER=
# ES_PASS=

# Optional
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...       # DeepSeek Flash, the default free model
# KIMI_API_KEY=sk-...           # optional: Kimi is own-key ("paid" tier) by default
# DB_PATH=data/users.db
# FREE_QUERIES_PER_DAY=10
# BYOK_QUERIES_PER_DAY=200   # searches a day with the user's own LLM key
# DEFAULT_MODEL_KEY=deepseek-flash
# RETRIEVAL_K=8
# RETRIEVAL_NUM_CANDIDATES=100
# MAX_HISTORY_TURNS=6

# Email notifications for new registrations
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yesdeputy.com
# ADMIN_EMAIL=
# SITE_URL=https://yesdeputy.com
